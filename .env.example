# Mem0 Test Program - Environment Variables Example
# Copy this file to .env and update the values

# ======================
# Backend Configuration
# ======================

# Server Settings
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
LOG_LEVEL=INFO

# ======================
# Ollama Configuration
# ======================

# Ollama Server URL
# For local: http://localhost:11434
# For Docker: http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434

# Default LLM Model
# Options: llama3.2:latest, mistral:latest, gemma2:latest, etc.
OLLAMA_DEFAULT_MODEL=llama3.2:latest

# Embedding Model
# Options: nomic-embed-text:latest, all-minilm:latest, etc.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# ======================
# Mem0 Configuration
# ======================

# Vector Store Path (Qdrant embedded mode)
VECTOR_STORE_PATH=./data/qdrant

# History Database Path (SQLite)
HISTORY_DB_PATH=./data/memory_history.db

# ======================
# CORS Configuration
# ======================

# Allowed origins (comma-separated for multiple origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ======================
# Frontend Configuration
# ======================

# API Base URL
VITE_API_BASE_URL=http://localhost:8000

# Default User ID (for testing)
VITE_DEFAULT_USER_ID=user123
